})

local autoLiftWeight = false
local liftThreadId = 0
local turboLift = false

FarmSection:Toggle({
    Title = "⚡ Lift Weight Fast • Turbo",
    Desc = "Farm de força com referências em cache e ciclo otimizado",
    Value = false,
    Callback = function(Value)
        autoLiftWeight = Value
        liftThreadId += 1
        local thisThread = liftThreadId

        DebugInfo("Lift Fast = " .. tostring(Value))

        if not Value then
            DebugInfo("Lift Fast stopped.")
            return
        end

        task.spawn(function()
            local player = Players.LocalPlayer
            local backpack = player:WaitForChild("Backpack")

            DebugInfo("Lift Fast thread started.")

            while autoLiftWeight and thisThread == liftThreadId do
                local ok, err = pcall(function()
                    local character = player.Character
                    if not character then return end

                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if not humanoid or humanoid.Health <= 0 then return end

                    local weight = character:FindFirstChild("Weight")
                        or backpack:FindFirstChild("Weight")

                    if not weight then
                        for _, object in ipairs(character:GetChildren()) do
                            if object:IsA("Tool") then
                                weight = object
                                break
                            end
                        end
                    end

                    if not weight then
                        for _, object in ipairs(backpack:GetChildren()) do
                            if object:IsA("Tool") then
                                weight = object
                                break
                            end
                        end
                    end

                    if not weight then return end

                    local muscleEvent = player:FindFirstChild("muscleEvent")
                    if not muscleEvent then
                        local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
                        muscleEvent = rEvents and rEvents:FindFirstChild("muscleEvent")
                    end
                    if not muscleEvent then return end

                    if weight.Parent == backpack then
                        humanoid:EquipTool(weight)
                        task.wait()
                    end

                    if weight.Parent == character then
                        local reps = turboLift and 5 or 3
                        for _ = 1, reps do
                            muscleEvent:FireServer("rep", weight)
                        end
                    end
                end)

                if not ok then
                    DebugError("Lift Fast runtime error", err)
                end

                task.wait(turboLift and 0.003 or 0.005)
            end

            DebugInfo("Lift Fast thread ended.")
        end)
    end
})

