                    nearestDistance = distance
                    nearestEntry = entry
                end
            end
        end

        if nearestEntry then
            teleportToEggEntry(nearestEntry)
        else
            WindUI:Notify({
                Title = "🥚 Egg Teleport",
                Content = "Nenhum Crystal foi encontrado.",
                Duration = 3
            })
        end
    end
})

