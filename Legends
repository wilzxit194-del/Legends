local function getCrystalPosition(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object.Position
    end

    if object:IsA("Model") then
        if object.PrimaryPart then
            return object.PrimaryPart.Position
        end

        local cf = object:GetBoundingBox()
        if cf then
            return cf.Position
        end
    end

    if object:IsA("Attachment") then
        return object.WorldPosition
    end

    return nil
end

local function scanEggTeleportEntries()
    local entries = {}
    local seenNames = {}

    local mapCrystalsFolder = workspace:FindFirstChild("mapCrystalsFolder")

    if mapCrystalsFolder then
        for _, object in ipairs(mapCrystalsFolder:GetChildren()) do
            local objectName = tostring(object.Name)
            local lowerName = objectName:lower()

            if lowerName ~= "crystal"
                and lowerName:find("crystal", 1, true)
                and not lowerName:find("script", 1, true) then

                local position = getCrystalPosition(object)

                if position and not seenNames[lowerName] then
                    seenNames[lowerName] = true
                    entries[#entries + 1] = {
                        object = object,
                        name = objectName,
                        displayName = objectName,
                        position = position
                    }
                end
            end
        end
    end

    for _, object in ipairs(workspace:GetDescendants()) do
        local objectName = tostring(object.Name)
        local lowerName = objectName:lower()

        if teleportCrystalNameSet[lowerName]
            and not seenNames[lowerName]
            and not lowerName:find("script", 1, true) then

            local position = getCrystalPosition(object)

            if position then
                seenNames[lowerName] = true
                entries[#entries + 1] = {
                    object = object,
                    name = objectName,
                    displayName = objectName,
                    position = position
                }
            end
        end
    end

    for _, object in ipairs(workspace:GetDescendants()) do
        local objectName = tostring(object.Name)
        local lowerName = objectName:lower()

        if lowerName ~= "crystal"
            and lowerName:find("crystal", 1, true)
            and not lowerName:find("script", 1, true)
            and not seenNames[lowerName] then

            local position = getCrystalPosition(object)

            if position then
                seenNames[lowerName] = true
                entries[#entries + 1] = {
                    object = object,
                    name = objectName,
                    displayName = objectName,
                    position = position
                }
            end
        end
    end

    table.sort(entries, function(a, b)
        return a.name:lower() < b.name:lower()
    end)

    return entries
end

local function buildEggTeleportDropdownValues()
    local values = {}

    for _, entry in ipairs(eggTeleportEntries) do
        values[#values + 1] = entry.displayName
    end

    return values
end

