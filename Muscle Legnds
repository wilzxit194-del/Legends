-- Função de Seleção e Equipamento das Ferramentas Especificadas
local function equipBestTool()
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    if backpack and character then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local toolName = tool.Name
                if toolName == "Handstands" or toolName == "Situps" or toolName:find("Weight") or toolName:find("Haltere") or toolName:find("Pushups") then
                    character.Humanoid:EquipTool(tool)
                    break
                end
            end
        end
    end
end

