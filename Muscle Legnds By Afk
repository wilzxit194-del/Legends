-- Função para buscar pets (Nil/Hidden)
local function __getNil(name, class, debugId)
    local okNil, nilInsts = pcall(getnilinstances)
    if okNil and nilInsts then
        if debugId then
            for _, v in pairs(nilInsts) do
                if v.ClassName==class and v.Name==name then
                    local okId, id = pcall(function() return v:GetDebugId() end)
                    if okId and id==debugId then return v end
                end
            end
        end
        for _, v in pairs(nilInsts) do
            if v.ClassName==class and v.Name==name then return v end
        end
    end
    local okGame, found = pcall(function()
        for _, v in ipairs(game:GetDescendants()) do
            if v.ClassName==class and v.Name==name then
                if not debugId then return v end
                local okId2, id2 = pcall(function() return v:GetDebugId() end)
                if okId2 and id2==debugId then return v end
            end
        end
        return nil
    end)
    return okGame and found or nil
end

