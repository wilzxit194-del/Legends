local safePlatform = nil
local noclipConnection = nil

-- Função de suporte para gerenciar a plataforma subterrânea e o noclip
local function updatePlatformAndNoclip()
    local shouldBeActive = autoOpenMasters or autoOpenRibs
    local RunService = game:GetService("RunService")
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    
    if shouldBeActive then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = player.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if not autoOpenMasters and not autoOpenRibs then
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
            if safePlatform then
                safePlatform:Destroy()
                safePlatform = nil
            end
        end
    end
end

