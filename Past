local autoSellByName = false

PetsSection:Toggle({
    Title = "🔥 Enable Auto Sell Total (Marked Names Only)",
    Desc = "Sells inventory pets matching the names above",
    Value = false,
    Callback = function(Value)
        autoSellByName = Value
        task.spawn(function()
            local replicatedStorage = game:GetService("ReplicatedStorage")
            local player = game:GetService("Players").LocalPlayer
            
            while autoSellByName do
                pcall(function()
                    local rEvents = replicatedStorage:FindFirstChild("rEvents") or replicatedStorage:FindFirstChild("vEvents")
                    local sellRemote = rEvents and rEvents:FindFirstChild("sellPetEvent")
                    
                    if sellRemote then
                        local petsFolder = player:FindFirstChild("petsFolder") or player:FindFirstChild("pets")
                        if petsFolder then
                            
                            local function processPet(pet)
                                local isEquipped = false
                                if pet:FindFirstChild("equipped") and pet.equipped.Value == true then
                                    isEquipped = true
                                elseif pet:FindFirstChild("Equipped") and pet.Equipped.Value == true then
                                    isEquipped = true
                                end

                                if not isEquipped then
                                    local petName = pet.Name
                                    
                                    for targetName, enabled in pairs(targetPetNames) do
                                        if enabled and (petName == targetName or string.find(petName:lower(), targetName:lower())) then
                                            sellRemote:FireServer("sellPet", pet)
                                            task.wait(0.02)
                                            break
                                        end
                                    end
                                end
                            end

                            local function scanContainer(container)
                                local successScan, err = pcall(function()
                                    for _, child in ipairs(container:GetChildren()) do
                                        if child:IsA("Folder") then
                                            scanContainer(child)
                                        else
                                            processPet(child)
                                        end
                                    end
                                end)
                            end

                            scanContainer(petsFolder)
                        end
                    end
                end)
                task.wait(0.3)
            end
        end)
