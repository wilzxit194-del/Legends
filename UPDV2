})

local ascensionActive = false
local ascensionThreadId = 0

AscensionSection:Toggle({
    Title = "🌌 ASCENSION",
    Desc = "Automated execution for AscensionClient using hooks",
    Value = false,
    Callback = function(Value)
        ascensionActive = Value
        ascensionThreadId += 1
        local thisThread = ascensionThreadId

        if not Value then
            return
        end

        task.spawn(function()
            local ok, err = pcall(function()
                local player = game:GetService("Players").LocalPlayer
                local successClient, playerGui = pcall(function()
                    return player:WaitForChild("PlayerGui", 5)
                end)

                if playerGui then
                    local gameGui = playerGui:FindFirstChild("gameGui")
                    if gameGui then
                        local ascensionClient = gameGui:FindFirstChild("AscensionClient")
                    end
                end

                local Event = game:GetService("ReplicatedStorage").rEvents.ascensionRemote
                
                if Event then
                    local mtHook; mtHook = hookmetamethod(game, "__namecall", function(...)
                        local self = ...

                        if rawequal(self, Event) and getnamecallmethod() == "InvokeServer" then
                            local Args = table.pack(...)
                            local Result = table.pack(
                                mtHook(self, table.unpack(Args, 1, Args.n))
                            )

                            print(`Intercepted (__namecall) {Event.Name}:InvokeServer()`, ...)
                            return table.unpack(Result, 1, Result.n)
                        end

                        return mtHook(...)
                    end)

                    local OldInvokeServer; OldInvokeServer = hookfunction(Event.InvokeServer, function(...)
                        local self = ...

                        if rawequal(self, Event) then
                            local Args = table.pack(...)
                            local Result = table.pack(
                                OldInvokeServer(table.unpack(Args, 1, Args.n))
                            )

                            print(`Intercepted (__index) {Event.Name}:InvokeServer()`, self, table.unpack(Result, 1, Result.n))
                            return table.unpack(Result, 1, Result.n)
                        end

                        return OldInvokeServer(self, ...)
                    end)

                    while ascensionActive and thisThread == ascensionThreadId do
                        pcall(function()
                            Event:InvokeServer()
                        end)
                        task.wait(1)
                    end
                end
            end)

            if not ok then
                DebugError("Ascension runtime error", err)
            end
        end)
    end
})

-- ==================== REBIRTH MAX (FIXED & FULL INTEGRATION) ====================
local RebirthSection = FarmTab:Section({
    Title = "♻️ Rebirth"
})

local rebirthCustom = false
local rebirthThreadId = 0

RebirthSection:Toggle({
    Title = "👑 REBIRTH MAX (Auto Limit)",
    Desc = "Calcula e executa automaticamente o máximo de rebirths exatos do jogo",
    Value = false,

    Callback = function(Value)
        rebirthCustom = Value
        rebirthThreadId += 1
        local thisThread = rebirthThreadId

        DebugInfo("Rebirth Max = " .. tostring(Value))

        if not Value then
            return
        end

        task.spawn(function()
            local leaderstats = localPlayer:WaitForChild("leaderstats", 5)
            local strength = leaderstats and leaderstats:WaitForChild("Strength", 5)
            local rebirths = leaderstats and leaderstats:WaitForChild("Rebirths", 5)
            local globalFunctions = require(ReplicatedStorage:WaitForChild("globalFunctions"))
            local rEvents = ReplicatedStorage:WaitForChild("rEvents")
            local rebirthRemote = rEvents:WaitForChild("rebirthRemote")

            -- Algoritmo exato extraído do MassRebirthClient para calcular ciclos permitidos ("X1K")
            local function affordableCycles(p24)
                local v25 = globalFunctions.calculateRequiredRebirthStrength
                local v26 = rebirths.Value
                local v27 = localPlayer
                local v28 = tonumber(v25(v26, v27))
                
                local v29 = globalFunctions.calculateRequiredRebirthStrength
                local v30 = rebirths.Value + 1
                local v31 = localPlayer
                local v32 = tonumber(v29(v30, v31))
                
                if v28 == nil or (v32 == nil or (v28 < 0 or v32 < 0)) then
                    return 0
                end
                
                local v33 = v32 - v28
                local v34 = 0
                while v34 < p24 do
                    local v35 = (v34 + p24 + 1) * 0.5
                    local v36 = math.floor(v35)
                    if (v36 <= 0 and 0 or v36 * v28 + v33 * v36 * (v36 - 1) * 0.5) <= strength.Value then
                        v34 = v36
                    else
                        p24 = v36 - 1
                    end
                end
                return v34
            end

            while rebirthCustom and thisThread == rebirthThreadId do
                local ok, err = pcall(function()
                    if strength and rebirths and rebirthRemote then
                        -- Calcula o limite máximo suportado por requisição no jogo atual ("X1K" dinâmico)
                        local v61 = globalFunctions.calculateMaxRebirthsPerRequest
                        local v62 = localPlayer
                        local v63 = tonumber(v61(v62))
                        local v64 = math.floor(v63 or 100000)
                        local v65 = math.max(1, v64)
                        
                        local v66 = globalFunctions.calculatePetRebirthGainMultiplier
                        local v67 = localPlayer
                        local v68 = tonumber(v66(v67))
                        local v69 = v65 / ((v68 == nil or (v68 ~= v68 or v68 < 1)) and 1 or v68)
                        local v70 = math.floor(v69)
                        
                        -- Pega a quantidade exata suportada por ciclos
                        local finalRebirthAmount = affordableCycles(math.max(1, v70))

                        if finalRebirthAmount > 0 then
                            rebirthRemote:InvokeServer("rebirthRequest", finalRebirthAmount)
                        end
                    end
                end)

                if not ok then
                    DebugError("Rebirth runtime error", err)
                end

                task.wait(0.5)
            end
        end)
    end
})

