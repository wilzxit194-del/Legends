            end

            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if hrp then
                frozenCFrame = hrp.CFrame
            end

            freezeConnection = RunService.Heartbeat:Connect(function()
                local currentCharacter = player.Character
                local currentHrp = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")

                if currentHrp and frozenCFrame then
                    currentHrp.CFrame = frozenCFrame
                    currentHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    currentHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end)

            DebugInfo("Freeze enabled.")
        else
            if freezeConnection then
                freezeConnection:Disconnect()
                freezeConnection = nil
            end

            frozenCFrame = nil
            DebugInfo("Freeze disabled.")
        end
    end
})

