local function getCrystalPosition(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object.Position
    end

    if object:IsA("Model") then
        if object.PrimaryPart then
            return object.PrimaryPart.Position
        end

        local cf = object:GetBoundingBox()
        if cf then
            return cf.Position
        end
    end

    if object:IsA("Attachment") then
        return object.WorldPosition
    end

    return nil
end

local function addTeleportCrystal(entries, seen, object, forcedName)
    if not object or not object.Parent then
        return
    end

    local rawName = forcedName or tostring(object.Name)
    local lowerName = rawName:lower()

    if lowerName == "crystal"
        or lowerName:find("script", 1, true) then
        return
    end

    if not lowerName:find("crystal", 1, true) then
        return
    end

    local position = getCrystalPosition(object)
    if not position then
        return
    end

    -- Evita duplicar o mesmo objeto.
    if seen[object] then
        return
    end

    seen[object] = true

    entries[#entries + 1] = {
        object = object,
        name = rawName,
        displayName = rawName,
        position = position
    }
end

local function scanEggTeleportEntries()
    local entries = {}
    local seenObjects = {}
    local seenNames = {}

    -- PRIMEIRO: usa os containers reais do mapCrystalsFolder.
    -- Isso é importante porque o log mostrou:
    -- mapCrystalsFolder."Nome do Crystal"
    --     └── Crystal
    --
    -- O erro anterior acontecia quando o filho "Crystal" era encontrado
    -- antes do container, fazendo a dropdown mostrar "Crystal (1)".
    local mapCrystalsFolder = workspace:FindFirstChild("mapCrystalsFolder")

    if mapCrystalsFolder then
        for _, object in ipairs(mapCrystalsFolder:GetChildren()) do
            local objectName = tostring(object.Name)
            local lowerName = objectName:lower()

            if lowerName ~= "crystal"
                and lowerName:find("crystal", 1, true)
                and not lowerName:find("script", 1, true) then

                local position = getCrystalPosition(object)

                if position and not seenNames[lowerName] then
                    seenNames[lowerName] = true
                    seenObjects[object] = true

                    entries[#entries + 1] = {
                        object = object,
                        name = objectName,
                        displayName = objectName,
                        position = position
                    }
                end
            end
        end
    end

    -- SEGUNDO: procura pelos nomes oficiais em qualquer outro lugar do
    -- Workspace. Assim também encontra Crystals que estejam fora da pasta.
    for _, object in ipairs(workspace:GetDescendants()) do
        local objectName = tostring(object.Name)
        local lowerName = objectName:lower()

        if teleportCrystalNameSet[lowerName]
            and not seenNames[lowerName]
            and not lowerName:find("script", 1, true) then

            local position = getCrystalPosition(object)

            if position then
                seenNames[lowerName] = true
                seenObjects[object] = true

                entries[#entries + 1] = {
                    object = object,
                    name = objectName,
                    displayName = objectName,
                    position = position
                }
            end
        end
    end

    -- TERCEIRO: pega algum Crystal adicional que o jogo possa adicionar
    -- no futuro, mas nunca transforma o filho genérico "Crystal" em opção.
    for _, object in ipairs(workspace:GetDescendants()) do
        local objectName = tostring(object.Name)
        local lowerName = objectName:lower()

        if lowerName ~= "crystal"
            and lowerName:find("crystal", 1, true)
            and not lowerName:find("script", 1, true)
            and not seenNames[lowerName] then

            local position = getCrystalPosition(object)

            if position then
                seenNames[lowerName] = true
                seenObjects[object] = true

                entries[#entries + 1] = {
                    object = object,
                    name = objectName,
                    displayName = objectName,
                    position = position
                }
            end
        end
    end

    table.sort(entries, function(a, b)
        return a.name:lower() < b.name:lower()
    end)

    return entries
end

local function buildEggTeleportDropdownValues()
    local values = {}

    for _, entry in ipairs(eggTeleportEntries) do
        values[#values + 1] = entry.displayName
    end

    return values
end

