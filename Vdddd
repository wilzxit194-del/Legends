-- ==================== GHOST V2 • ANTI-PVP ====================
local ghostV2Enabled = false
local ghostOriginalTransparency = {}
local ghostConnections = {}

local function ghostRemember(obj)
    if ghostOriginalTransparency[obj] == nil then
        if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
            ghostOriginalTransparency[obj] = obj.Transparency
        end
    end
end

local function ghostApplyCharacter(character, enabled)
    if not character then return end

    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
            if enabled then
                ghostRemember(obj)
                obj.Transparency = 1
            else
                local original = ghostOriginalTransparency[obj]
                if original ~= nil then
                    obj.Transparency = original
                end
            end
        end
    end
end

local function ghostDisconnect()
    for _, connection in ipairs(ghostConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(ghostConnections)
end

local function ghostSet(enabled)
    ghostV2Enabled = enabled == true
    ghostDisconnect()

    local player = Players.LocalPlayer

    if ghostV2Enabled then
        if player.Character then
            ghostApplyCharacter(player.Character, true)
        end

        table.insert(ghostConnections, player.CharacterAdded:Connect(function(character)
            task.wait(0.5)
            if ghostV2Enabled then
                ghostApplyCharacter(character, true)
            end
        end))

        if player.Character then
            table.insert(ghostConnections, player.Character.DescendantAdded:Connect(function(obj)
                if ghostV2Enabled and (obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture")) then
                    task.wait()
                    if ghostV2Enabled then
                        ghostRemember(obj)
                        obj.Transparency = 1
                    end
                end
            end))
        end
    else
        if player.Character then
            ghostApplyCharacter(player.Character, false)
        end
    end
end

